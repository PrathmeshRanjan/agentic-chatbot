# ==============================================================================
# Agentic Chatbot - Environment Variables Template
# Copy this file to .env and fill in your actual API keys.
# DO NOT commit your real .env file with secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM & Embeddings Model Providers
# ------------------------------------------------------------------------------
# Mistral AI API Key (Used by chat_node with mistralai:mistral-small-latest)
# Get key from: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Google Gemini API Key (Used by FAISS RAG with models/gemini-embedding-001)
# Get key from: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# ------------------------------------------------------------------------------
# 2. External Tools API Keys
# ------------------------------------------------------------------------------
# Tavily Search API Key (Used by search_tool for real-time web search)
# Get key from: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# OpenWeatherMap API Key (Used by get_current_weather tool)
# Get key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Alpha Vantage API Key (Used by get_stock_price tool)
# Get key from: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here

# ------------------------------------------------------------------------------
# 3. LangSmith Observability & Tracing (Optional but Recommended)
# ------------------------------------------------------------------------------
# Enable or disable LangSmith tracing (true / false)
LANGSMITH_TRACING=true

# LangSmith API Key
# Get key from: https://smith.langchain.com/
LANGSMITH_API_KEY=your_langsmith_api_key_here

# LangSmith Endpoint (default: https://api.smith.langchain.com or region-specific)
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# LangSmith Project Name for grouping conversation traces
LANGSMITH_PROJECT=agentic-chatbot
